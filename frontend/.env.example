# Assetra Frontend Environment Configuration Template
# Set these variables in your Vercel frontend project (or local frontend/.env.local).

# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Backend API Configuration
# Set this to your deployed assetra-api Vercel project URL (e.g. https://assetra-api.vercel.app)
# (Can safely remain blank on initial frontend deployment, and added once assetra-api is live)
VITE_API_URL=

# Ethereum Sepolia Blockchain Configuration (Chain ID 11155111)
VITE_CHAIN_ID=11155111
VITE_REGISTRY_CONTRACT_ADDRESS=0x525E82f822E004838004ffd6Fe1366Be244EC671
VITE_TOKEN_CONTRACT_ADDRESS=0x2F0d80D15773A473A00bE3B732D4B46974732501
VITE_MARKETPLACE_CONTRACT_ADDRESS=0x517082aA429ED926BDbeC904a1879BaE1aFd05f7
