# ==============================================================================
# Assetra Protocol - Sepolia Testnet Deployment Configuration
# Copy this file to .env:  Copy-Item .env.example .env
# NEVER commit the actual .env file or private keys to source control!
# ==============================================================================

# Ethereum Sepolia JSON-RPC Endpoint (Alchemy, Infura, QuickNode, etc.)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Deployer Wallet Private Key (Must be funded with testnet Sepolia ETH for gas fees)
# Accepts raw 64-character hex string with or without '0x' prefix
SEPOLIA_PRIVATE_KEY=your_private_key_here

# (Optional) Etherscan API Key for automated contract source code verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
